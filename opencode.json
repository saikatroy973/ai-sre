{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "ai-sre_": "allow",
    "ai-sre_ai_sre_health": "allow",
    "ai-sre_ai_sre_run": "allow",
    "ai-sre_ai_sre_get": "allow",
    "ai-sre_ai_sre_verify": "allow",
    "ai-sre_ai_sre_memory": "allow",
    "ai-sre_ai_sre_source_status": "allow",
    "ai-sre_ai_sre_docs": "allow"
  },
  "mcp": {
    "ai-sre": {
      "type": "local",
      "command": [
        ".venv/bin/python",
        "-m",
        "ai_sre.mcp_server"
      ],
      "enabled": true
    }
  }
}
