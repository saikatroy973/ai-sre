# Environment variables are not automatically loaded. Export them in your shell.
AI_SRE_BACKEND=fixture
AI_SRE_SCENARIO=selector-mismatch
AI_SRE_DATA_DIR=.data
# Optional separate evidence store for the read-only get/verify tools.
AI_SRE_EVIDENCE_STORE_DIR=
AI_SRE_TENANT=local
# Audit label for development-mode MCP calls and CLI memory searches.
# This is not an authentication boundary.
AI_SRE_MCP_ACTOR=memory-researcher
# Rotate hash-chained memory/tool audit logs at this size in bytes (0 disables rotation).
AI_SRE_MCP_AUDIT_MAX_BYTES=5000000
# Optional external anchor for audit entry counts and tail hashes. The server
# replaces this file on every append, so point it at a writable directory outside
# AI_SRE_DATA_DIR (separate account/mount), never at immutable/WORM storage.
AI_SRE_AUDIT_ANCHOR_DIR=
# Optional server-side tool allowlist. Legacy tokens without a claim use it in place of the
# role map; a signed tools claim is intersected with it. Short or full names, comma-separated.
AI_SRE_MCP_TOOLS=
# Optional Ed25519 actor token; required when AI_SRE_MCP_PUBLIC_KEY is set, and a
# token without a public key fails closed instead of falling back to development mode.
# This authenticates a caller but is not a same-uid boundary: agents running as
# the same OS user can read each other's configs, the shared signing key, and
# token-bearing child environments, and can open the evidence DB directly.
AI_SRE_MCP_ACTOR_TOKEN=
AI_SRE_MCP_PUBLIC_KEY=
# Optional override for the Kubernetes docs index used by ai_sre_docs
# (default: <AI_SRE_DATA_DIR>/k8s-docs/docs.sqlite3).
AI_SRE_DOCS_INDEX=
# Optional local semantic index (requires the "semantic" extra).
AI_SRE_MEMORY_SEMANTIC_MODEL=
AI_SRE_MEMORY_SEMANTIC_THRESHOLD=0.15
AI_SRE_CLUSTER=demo-cluster
AI_SRE_NAMESPACES=shop

# Required for the HTTP API; generate a unique value. No default token is provided.
AI_SRE_API_TOKEN=

# Deterministic is the credential-free baseline for the initial supported diagnosis.
AI_SRE_REASONER=deterministic

# Optional Scale SGP inference. All four values are required when reasoner=scale.
# Copy the API base URL and an enabled vendor/model ID from your Scale deployment.
SGP_API_BASE_URL=
SGP_API_KEY=
SGP_ACCOUNT_ID=
SGP_MODEL=

# Opt-in live reads only: install .[kubernetes], select a least-privilege context,
# and change AI_SRE_BACKEND to kubernetes. No automatic context fallback.
AI_SRE_KUBE_CONTEXT=

# Switch is the collaboration, identity, and memory system of record.
# `demo` always runs offline. `switch-demo`, `investigate`, and the HTTP API
# require Switch. The Switch server must be reachable before those commands run.
AI_SRE_SWITCH_MODE=required
AI_SRE_SWITCH_BASE_URL=http://127.0.0.1:18000
# The registration token is the Bearer token for POST /agents. `switch up`
# writes one to .data/switch/.env as AGENT_REGISTRATION_TOKEN; export it here.
AI_SRE_SWITCH_REGISTRATION_TOKEN=
AI_SRE_SWITCH_STATE_DIR=.data/switch
AI_SRE_SWITCH_REQUEST_TIMEOUT_SECONDS=10
AI_SRE_SWITCH_MEMORY_MAX_RECORDS=5
AI_SRE_SWITCH_MEMORY_EXPIRY_DAYS=180
AI_SRE_SWITCH_ROOM_HISTORY_LIMIT=100

# Switch Console is the mandatory live agent runtime. `switch console` uses the
# Console Gateway management API to create managed OpenCode agents and rooms.
# Set these explicitly, or point at the Console server env file. The password
# is never printed. `http://localhost:PORT` is accepted for a local Console.
AI_SRE_CONSOLE_SERVER_URL=http://localhost:63398
AI_SRE_CONSOLE_EMAIL=
AI_SRE_CONSOLE_PASSWORD=
# macOS default: ~/Library/Application Support/switchdash/local-switch-server/native/run/switch-core.env
AI_SRE_CONSOLE_ENV_FILE=
AI_SRE_CONSOLE_TIMEOUT_SECONDS=20

# Optional OpenTelemetry. Install the `otel` extra first. Empty endpoint = no
# exporter and no-op spans. This is not Switch Trust Live traffic.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-sre

# Optional read-only Switch Trust governance and ROI summaries. These are
# separate from the Switch room server: `switch trust status`, `switch trust
# publish`, and `switch roi` fail closed when the key is absent. Never commit a
# real key. Trust CLI and CodeScan CI use their own SWITCH_TRUST_TOKEN secrets.
AI_SRE_TRUST_API_KEY=
# The web app origin; the client derives the api. host. http://localhost:PORT
# is accepted only for a local backend.
AI_SRE_TRUST_INSTANCE=https://app.switchagents.ai
# Optional. The key is normally pinned to one tenant/workspace; if these are
# set they must match the key identity.
AI_SRE_TRUST_TENANT_ID=
AI_SRE_TRUST_WORKSPACE_ID=
AI_SRE_TRUST_TIMEOUT_SECONDS=15
# Optional path to the external switch-trust CLI used by `switch trust scan`.
AI_SRE_TRUST_CLI_BIN=switch-trust
